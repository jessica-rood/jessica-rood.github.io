@techreport{cunha2026beliefs,
  abbr        = {NBER},
  bibtex_show = {true},
  title       = {Beliefs, Attention, and Investments in Early Childhood},
  author      = {Cunha, Fl\'avio and Nihtianova, Snejana and Rood, Jessica and van der Merwe, Anja-Lize},
  year        = {2026},
  institution = {National Bureau of Economic Research},
  type        = {NBER Working Paper},
  number      = {35150},
  category    = {working_paper},
  html        = {https://www.nber.org/papers/w35150},
  selected    = {true},
  abstract    = {We evaluate the LENA Start Program, a group-based parent education intervention designed to increase early language exposure for children from low-income families, using a randomized controlled trial conducted with Alief Independent School District in Houston. Intent-to-treat analyses find significant effects on parental knowledge (0.50 SD) and beliefs (0.70 SD), conversational turns (0.30 SD), the broader home language environment (0.58 SD on StimQ), and child language development (0.28 SD on the LENA Developmental Snapshot). Heterogeneity analyses using causal forests find no systematic variation in treatment effects by observable characteristics. The pattern of effects suggests the intervention operates primarily through knowledge transmission rather than by building parental confidence or altering underlying preferences.}
}

@unpublished{rood_nyc_ddc,
  bibtex_show = {true},
  title       = {Evolving Choices: Childcare and Maternal Labor Supply in a Dynamic Framework},
  author      = {Rood, Jessica},
  year        = {2026},
  note        = {Work in progress},
  category    = {work_in_progress},
  abstract    = {This paper develops a dynamic discrete choice model of maternal employment and childcare decisions in the context of New York City's 3-K for All expansion. Families rarely rely on a single arrangement: they assemble bundles---a primary program plus relative or other informal care covering the hours a work schedule demands---and they revise those bundles as children age and public options open. The model centers on these two features: childcare bundling, with uncovered hours priced rather than prohibited, and the dynamic sequencing of care and work choices over early childhood. The model will be used to evaluate counterfactual policies, including subsidy expansions and extended-day coverage.}
}

@unpublished{rood_lee_turnover,
  bibtex_show = {true},
  title       = {High Staff Turnover: The Systemic Barrier Undermining Early Childhood Education Quality Improvement Initiatives},
  author      = {Rood, Jessica and Lee, Ji-Hee and Nihtianova, Snejana and Bouek, Jennifer},
  year        = {2026},
  note        = {Work in progress},
  category    = {work_in_progress},
  abstract    = {This paper examines turnover in the early childhood education workforce using qualitative methods, asking how high staff turnover undermines the very initiatives designed to improve childcare quality. Drawing on 90+ interviews across three Texas-based quality improvement programs---Shared Services Alliances, the Early Educator Registered Apprenticeship Program, and the Pre-K Partnership Expansion Initiative---we identify a vicious cycle in which workforce instability hampers program implementation. Emerging themes include a professional-development paradox, threats to partnership viability, and a mismatch between program design and the realities of ECE careers.}
}

@unpublished{rood_houston_sc,
  bibtex_show = {true},
  title       = {When Free Isn't Enough: A Stated Choice Experiment to Understand Low Pre-K Enrollment},
  author      = {Rood, Jessica},
  year        = {2026},
  note        = {Work in progress},
  category    = {work_in_progress},
  abstract    = {Despite substantial public investment, roughly 60\% of eligible Houston families do not enroll in free public pre-K. This paper asks how families learn about, consider, and choose early care and education---and what knowing the facts would change. In a survey of Houston-area families with children ages one to four, stated-choice screens place every option in front of each family at true or experimentally set attributes, recovering preferences without frictions, while expected and past choices carry the frictions; measured awareness and beliefs separate the two. A randomized information treatment---one bundled fact about cost, hours, eligibility, and sign-up, against a deadline reminder---tests what correct information changes in beliefs and in expected choices at the age-3 and age-4 pre-K transitions. Fielding is planned for spring 2027.}
}
