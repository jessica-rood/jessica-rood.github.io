@techreport{kinder2026northstars,
  abbr        = {Kinder},
  bibtex_show = {true},
  title       = {Economic Mobility in the Houston Area, Part 2: A Proposal of Four North Stars},
  author      = {Ahamed, Hasan and Nihtianova, Snejana and Njeh, Joy and Rood, Jessica and Selsberg, Bradley and van der Merwe, Anja-Lize and Cunha, Fl\'avio},
  year        = {2026},
  institution = {Center for Economic Mobility, Kinder Institute for Urban Research, Rice University},
  note        = {Center for Economic Mobility, Kinder Institute for Urban Research, Rice University},
  category    = {report},
  doi         = {10.25611/cxjs-1r88},
  html        = {https://kinder.rice.edu/research/economic-mobility-houston-area-part-2-proposal-four-north-stars},
  abstract    = {Proposes four measurable North Stars for the Coalition for Economic Mobility's goal of improving economic success across the 10-county Houston region by 2040: children grow up out of poverty; children grow up in places that pay a dividend; young people stay connected to school or work; and adults reach economic security. Each pairs an aspiration with a measure built from public national data, so anyone can compute, verify, and compare it across regions; the measures track conditions but do not identify the effects of particular initiatives.}
}
